<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ChristMembers.ViewModels"
             x:Class="ChristMembers.ListaVisitantes"
             Title="Visitantes"
             BackgroundColor="#F4F6FB">

    <Grid RowDefinitions="Auto,Auto,*" Padding="20,16,20,0" RowSpacing="10">

        <SearchBar Grid.Row="0"
                   Placeholder="Buscar por nome ou telefone"
                   Text="{Binding TextoBusca}"
                   TextColor="#1B2559"
                   PlaceholderColor="#9AA1BC"
                   BackgroundColor="White" />

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <Label Grid.Column="0"
                   Text="{Binding Resumo}"
                   FontSize="14"
                   TextColor="#6B7390"
                   VerticalOptions="Center" />

            <Picker Grid.Column="1"
                    Title="Status"
                    WidthRequest="150"
                    ItemsSource="{Binding OpcoesStatus}"
                    SelectedItem="{Binding StatusFiltro}"
                    TextColor="#1B2559"
                    TitleColor="#9AA1BC" />
        </Grid>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Visitantes}">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
            </CollectionView.ItemsLayout>

            <CollectionView.EmptyView>
                <Label Text="Nenhum visitante encontrado."
                       FontSize="16"
                       TextColor="#6B7390"
                       HorizontalOptions="Center"
                       Margin="0,40,0,0" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeShape="RoundRectangle 20"
                            Stroke="#E4E8F4"
                            StrokeThickness="1"
                            BackgroundColor="White"
                            Padding="18">

                        <VerticalStackLayout Spacing="10">

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Grid.Column="0" Spacing="3">
                                    <Label Text="{Binding Nome}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="18"
                                           TextColor="#1B2559" />
                                    <Label Text="{Binding Telefone}"
                                           FontSize="14"
                                           TextColor="#6B7390" />
                                </VerticalStackLayout>

                                <Border Grid.Column="1"
                                        StrokeShape="RoundRectangle 12"
                                        StrokeThickness="0"
                                        BackgroundColor="#EEF2FF"
                                        Padding="10,5"
                                        VerticalOptions="Start">
                                    <Label Text="{Binding TextoStatus}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="12"
                                           TextColor="#3C4A7D" />
                                </Border>
                            </Grid>

                            <Label Text="{Binding DataVisita, StringFormat='Visita em {0:dd/MM/yyyy}'}"
                                   FontSize="13"
                                   TextColor="#B07A12" />

                            <Label Text="{Binding DataContato, StringFormat='Contatado em {0:dd/MM/yyyy}'}"
                                   IsVisible="{Binding TemContato}"
                                   FontSize="13"
                                   TextColor="#2E7D5B" />

                            <Button Text="Enviar boas-vindas no WhatsApp"
                                    IsVisible="{Binding PodeWhatsApp}"
                                    FontSize="13"
                                    TextColor="#1F6B47"
                                    BackgroundColor="#E3F6EC"
                                    CornerRadius="12"
                                    HeightRequest="40"
                                    HorizontalOptions="Start"
                                    Padding="16,0"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ListaVisitantesViewModel}}, Path=WhatsAppCommand}"
                                    CommandParameter="{Binding .}" />

                            <Editor Placeholder="Anotação da liderança (ex.: ligou na quarta)"
                                    AutoSize="TextChanges"
                                    MaxLength="300"
                                    FontSize="14"
                                    TextColor="#1B2559"
                                    PlaceholderColor="#9AA1BC"
                                    Text="{Binding Anotacao, Mode=TwoWay}" />

                            <Button Text="Salvar anotação"
                                    FontSize="13"
                                    TextColor="#1B2F7A"
                                    BackgroundColor="Transparent"
                                    BorderColor="#C9D3F5"
                                    BorderWidth="1"
                                    CornerRadius="12"
                                    HeightRequest="38"
                                    HorizontalOptions="Start"
                                    Padding="16,0"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ListaVisitantesViewModel}}, Path=SalvarAnotacaoCommand}"
                                    CommandParameter="{Binding .}" />

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Button Grid.Column="0"
                                        Text="{Binding TextoProximaAcao}"
                                        FontFamily="OpenSansSemibold"
                                        FontSize="14"
                                        TextColor="White"
                                        BackgroundColor="#1B2F7A"
                                        CornerRadius="14"
                                        HeightRequest="44"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ListaVisitantesViewModel}}, Path=AlterarStatusCommand}"
                                        CommandParameter="{Binding .}" />

                                <Button Grid.Column="1"
                                        Text="Excluir"
                                        FontSize="14"
                                        TextColor="#C62828"
                                        BackgroundColor="#FDECEC"
                                        CornerRadius="14"
                                        HeightRequest="44"
                                        Padding="16,0"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ListaVisitantesViewModel}}, Path=ExcluirCommand}"
                                        CommandParameter="{Binding .}" />
                            </Grid>

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <BoxView HeightRequest="24" Color="Transparent" />
            </CollectionView.Footer>

        </CollectionView>
    </Grid>

</ContentPage>