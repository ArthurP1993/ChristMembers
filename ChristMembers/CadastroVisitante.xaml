<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:ChristMembers.Behaviors"
             x:Class="ChristMembers.CadastroVisitante"
             Title="Visitante">

    <ScrollView>
        <VerticalStackLayout Padding="30,20" Spacing="20">

            <Label Text="Cadastro de visitante"
                   FontSize="24"
                   HorizontalOptions="Center"
                   SemanticProperties.HeadingLevel="Level1" />

            <Entry Placeholder="Nome"
                   Text="{Binding Nome}" />

            <Entry Placeholder="Telefone (00) 00000-0000"
                                Keyboard="Numeric"
                                Text="{Binding Telefone}">
                <Entry.Behaviors>
                    <behaviors:MascaraTelefoneBehavior />
                </Entry.Behaviors>
            </Entry>

            <Label Text="{Binding MensagemErro}"
                   TextColor="Red"
                   IsVisible="{Binding TemErro}" />

            <Button Text="Cadastrar"
                    Command="{Binding CadastrarCommand}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>