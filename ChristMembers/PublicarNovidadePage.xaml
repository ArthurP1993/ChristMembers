<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:ChristMembers.Behaviors"
             x:Class="ChristMembers.PublicarNovidadePage"
             Title="Publicar novidade"
             BackgroundColor="#F4F6FB">

    <ScrollView>
        <VerticalStackLayout Padding="24,24,24,60" Spacing="20">

            <Label Text="Nova novidade"
                   FontFamily="OpenSansSemibold"
                   FontSize="28"
                   TextColor="#1B2559"
                   SemanticProperties.HeadingLevel="Level1" />

            <Border StrokeShape="RoundRectangle 24"
                    Stroke="#E4E8F4"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    Padding="20">

                <VerticalStackLayout Spacing="14">

                    <Border IsVisible="{Binding TemFoto}"
                            StrokeShape="RoundRectangle 18"
                            StrokeThickness="0"
                            Padding="0">
                        <Image Source="{Binding PreviaFoto}"
                               HeightRequest="190"
                               Aspect="AspectFill" />
                    </Border>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Button Grid.Column="0"
                                Text="{Binding TextoBotaoFoto}"
                                FontFamily="OpenSansSemibold"
                                FontSize="15"
                                TextColor="#1B2F7A"
                                BackgroundColor="#E4EBFF"
                                CornerRadius="14"
                                HeightRequest="48"
                                Command="{Binding EscolherFotoCommand}" />

                        <Button Grid.Column="1"
                                Text="Remover"
                                IsVisible="{Binding TemFoto}"
                                FontSize="14"
                                TextColor="#C62828"
                                BackgroundColor="Transparent"
                                Command="{Binding RemoverFotoCommand}" />
                    </Grid>

                    <Entry Placeholder="Título"
                           MaxLength="80"
                           TextColor="#1B2559"
                           PlaceholderColor="#9AA1BC"
                           Text="{Binding Titulo}" />

                    <Editor Placeholder="Descrição (opcional)"
                            MaxLength="500"
                            HeightRequest="140"
                            TextColor="#1B2559"
                            PlaceholderColor="#9AA1BC"
                            Text="{Binding Descricao}" />

                    <Entry Placeholder="Data do evento (dd/mm/aaaa)"
                           Keyboard="Numeric"
                           TextColor="#1B2559"
                           PlaceholderColor="#9AA1BC"
                           Text="{Binding DataEventoTexto}">
                        <Entry.Behaviors>
                            <behaviors:MascaraDataBehavior />
                        </Entry.Behaviors>
                    </Entry>

                    <Label Text="Sem data, a novidade fica fixa no final do feed. Com data, ela some sozinha no dia seguinte ao evento."
                           FontSize="13"
                           LineHeight="1.3"
                           TextColor="#6B7390" />

                    <Label Text="{Binding MensagemErro}"
                           TextColor="#C62828"
                           FontSize="14"
                           IsVisible="{Binding TemErro}" />

                    <Button Text="Publicar"
                            FontFamily="OpenSansSemibold"
                            FontSize="17"
                            TextColor="White"
                            BackgroundColor="#1B2F7A"
                            CornerRadius="16"
                            HeightRequest="52"
                            Command="{Binding PublicarCommand}" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>