<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ChristMembers.CarteirinhaMembro"
             Title="Carteirinha"
             BackgroundColor="#F4F6FB">

    <ScrollView>
        <VerticalStackLayout Padding="20,20,20,40" Spacing="18">

            <!-- Credencial -->
            <Border StrokeShape="RoundRectangle 24"
                    Stroke="#E4E8F4"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    Padding="0">
                <Border.Shadow>
                    <Shadow Brush="#1B2F7A" Opacity="0.25" Radius="22" Offset="0,10" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="0">

                    <!-- Cabeçalho: logo, nome da igreja e tipo da credencial -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="16">
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1B2F7A" Offset="0.0" />
                                <GradientStop Color="#4B3DB8" Offset="1.0" />
                            </LinearGradientBrush>
                        </Grid.Background>

                        <Border Grid.Column="0"
                                StrokeShape="Ellipse"
                                StrokeThickness="0"
                                BackgroundColor="White"
                                Padding="6"
                                WidthRequest="60"
                                HeightRequest="60">
                            <Image Source="logo.png" Aspect="AspectFit" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label Text="{Binding NomeIgreja}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="15"
                                   TextColor="White" />
                            <Label Text="{Binding TituloCredencial}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="13"
                                   TextColor="#F8CE62" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Foto e dados principais -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Padding="16,16,16,10">

                        <VerticalStackLayout Grid.Column="0" Spacing="8" WidthRequest="96">

                            <Border StrokeShape="RoundRectangle 12"
                                    Stroke="#E4E8F4"
                                    StrokeThickness="1"
                                    BackgroundColor="#EEF0F7"
                                    WidthRequest="96"
                                    HeightRequest="128"
                                    Padding="0">
                                <Grid>
                                    <Image Source="{Binding FotoUrl}"
                                           IsVisible="{Binding TemFoto}"
                                           Aspect="AspectFill" />
                                    <Label Text="{Binding Iniciais}"
                                           IsVisible="{Binding SemFoto}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="30"
                                           TextColor="#9AA1BC"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Border>

                            <Button x:Name="BotaoFoto"
                                    IsVisible="False"
                                    Text="{Binding TextoBotaoFoto}"
                                    FontSize="12"
                                    TextColor="#1B2F7A"
                                    BackgroundColor="#E4EBFF"
                                    CornerRadius="10"
                                    HeightRequest="34"
                                    Padding="4,0"
                                    Clicked="OnTrocarFotoClicked" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="{Binding Nome}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="18"
                                   TextColor="#1B2559"
                                   SemanticProperties.HeadingLevel="Level1" />

                            <Label Text="{Binding Numero}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="13"
                                   TextColor="#B07A12" />

                            <VerticalStackLayout Spacing="1" IsVisible="{Binding TemCargo}">
                                <Label Text="Cargo" FontSize="11" TextColor="#9AA1BC" />
                                <Label Text="{Binding Cargo}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="14"
                                       TextColor="#8A5A00" />
                            </VerticalStackLayout>
                            
                            <VerticalStackLayout Spacing="1">
                                <Label Text="Data de nascimento" FontSize="11" TextColor="#9AA1BC" />
                                <Label Text="{Binding NascimentoTexto}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="14"
                                       TextColor="#1B2559" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="1">
                                <Label Text="CPF" FontSize="11" TextColor="#9AA1BC" />
                                <Label Text="{Binding CpfTexto}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="14"
                                       TextColor="#1B2559" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#EEF0F7" Margin="16,0" />

                    <!-- Emissão, membresia, batismo, congregação e telefone -->
                    <FlexLayout BindableLayout.ItemsSource="{Binding CamposCartao}"
                                Direction="Row"
                                Wrap="Wrap"
                                AlignItems="Start"
                                JustifyContent="Start"
                                Padding="16,12,8,2">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout FlexLayout.Basis="50%"
                                                     Padding="0,0,8,10"
                                                     Spacing="1">
                                    <Label Text="{Binding Rotulo}"
                                           FontSize="11"
                                           TextColor="#9AA1BC" />
                                    <Label Text="{Binding Valor}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="14"
                                           TextColor="#1B2559" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <!-- CNPJ e endereço da igreja -->
                    <VerticalStackLayout Padding="16,0,16,12" Spacing="8">

                        <VerticalStackLayout Spacing="1" IsVisible="{Binding TemEnderecoIgreja}">
                            <Label Text="Dados da Igreja" FontSize="11" TextColor="#9AA1BC" />
                            <Label Text="{Binding EnderecoIgreja}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="13"
                                   LineHeight="1.25"
                                   TextColor="#1B2559" />
                        </VerticalStackLayout>
                        
                        <VerticalStackLayout Spacing="1" IsVisible="{Binding TemCnpjIgreja}">
                            <Label Text="{Binding CnpjIgreja}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="14"
                                   TextColor="#1B2559" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                    
                    <!-- Rodapé -->
                    <Grid BackgroundColor="#F4F6FB" Padding="16,12">
                        <Label Text="É assegurada, nos termos da lei, a prestação de assistência religiosa nas entidades civis e militares de internação coletiva. Artigo 5, inciso VII, CF."
                               FontSize="11"
                               FontAttributes="Italic"
                               LineHeight="1.3"
                               TextColor="#6B7390"
                               HorizontalTextAlignment="Center" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- Dados cadastrais (abre e fecha) -->
            <Button x:Name="BotaoDados"
                    Text="Dados cadastrais  ▾"
                    FontFamily="OpenSansSemibold"
                    FontSize="16"
                    TextColor="#1B2F7A"
                    BackgroundColor="#E4EBFF"
                    CornerRadius="16"
                    HeightRequest="52"
                    Clicked="OnDadosClicked" />

            <Border x:Name="PainelDados"
                    IsVisible="False"
                    StrokeShape="RoundRectangle 24"
                    Stroke="#E4E8F4"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    Padding="20,6,20,16">

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Dados}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <VerticalStackLayout Spacing="2" Padding="0,12,0,0">
                                <Label Text="{Binding Rotulo}"
                                       FontSize="12"
                                       TextColor="#9AA1BC" />
                                <Label Text="{Binding Valor}"
                                       FontSize="16"
                                       LineHeight="1.3"
                                       TextColor="#1B2559" />
                                <BoxView HeightRequest="1"
                                         Color="#EEF0F7"
                                         Margin="0,12,0,0" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>

            <!-- Editar (administrador) -->
            <Button x:Name="BotaoEditar"
                    Text="Editar cadastro"
                    FontFamily="OpenSansSemibold"
                    FontSize="16"
                    TextColor="#1B2F7A"
                    BackgroundColor="#E4EBFF"
                    CornerRadius="16"
                    HeightRequest="52"
                    Clicked="OnEditarClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>