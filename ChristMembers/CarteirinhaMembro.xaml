<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ChristMembers.CarteirinhaMembro"
             Title="Carteirinha"
             BackgroundColor="#F4F6FB">

    <ScrollView>
        <VerticalStackLayout Padding="20,20,20,40" Spacing="20">

            <!-- Carteirinha -->
            <Border StrokeShape="RoundRectangle 28"
                    StrokeThickness="0"
                    Padding="24">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1B2F7A" Offset="0.0" />
                        <GradientStop Color="#4B3DB8" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Shadow>
                    <Shadow Brush="#1B2F7A" Opacity="0.30" Radius="24" Offset="0,12" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="18">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Text="IADA"
                               FontFamily="OpenSansSemibold"
                               FontSize="16"
                               CharacterSpacing="4"
                               TextColor="#F8CE62" />
                        <Label Grid.Column="1"
                               Text="{Binding Numero}"
                               FontSize="14"
                               TextColor="#CCFFFFFF" />
                    </Grid>

                    <Border StrokeShape="Ellipse"
                            Stroke="#66FFFFFF"
                            StrokeThickness="1.5"
                            BackgroundColor="#26FFFFFF"
                            WidthRequest="78"
                            HeightRequest="78"
                            HorizontalOptions="Start">
                        <Label Text="{Binding Iniciais}"
                               FontFamily="OpenSansSemibold"
                               FontSize="28"
                               TextColor="White"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding Nome}"
                               FontFamily="OpenSansSemibold"
                               FontSize="26"
                               TextColor="White"
                               SemanticProperties.HeadingLevel="Level1" />
                        <Label Text="{Binding MembroDesde}"
                               FontSize="15"
                               TextColor="#D6DBF5" />
                    </VerticalStackLayout>

                    <Border StrokeShape="RoundRectangle 14"
                            StrokeThickness="0"
                            BackgroundColor="{Binding CorFundoBatismo}"
                            Padding="14,6"
                            HorizontalOptions="Start">
                        <Label Text="{Binding TextoBatismo}"
                               FontFamily="OpenSansSemibold"
                               FontSize="13"
                               TextColor="{Binding CorTextoBatismo}" />
                    </Border>

                </VerticalStackLayout>
            </Border>

            <!-- Dados do cadastro -->
            <Border StrokeShape="RoundRectangle 24"
                    Stroke="#E4E8F4"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    Padding="20,16">

                <VerticalStackLayout Spacing="0">

                    <Label Text="Dados do cadastro"
                           FontFamily="OpenSansSemibold"
                           FontSize="18"
                           TextColor="#1B2559"
                           Margin="0,0,0,6" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Dados}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout Spacing="2" Padding="0,12,0,0">
                                    <Label Text="{Binding Rotulo}"
                                           FontSize="12"
                                           TextColor="#9AA1BC" />
                                    <Label Text="{Binding Valor}"
                                           FontSize="16"
                                           LineHeight="1.3"
                                           TextColor="#1B2559" />
                                    <BoxView HeightRequest="1"
                                             Color="#EEF0F7"
                                             Margin="0,12,0,0" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!-- Editar -->
            <Button x:Name="BotaoEditar"
                    Text="Editar cadastro"
                    FontFamily="OpenSansSemibold"
                    FontSize="16"
                    TextColor="#1B2F7A"
                    BackgroundColor="#E4EBFF"
                    CornerRadius="16"
                    HeightRequest="52"
                    Clicked="OnEditarClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>