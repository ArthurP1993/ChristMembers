<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ChristMembers.PresencasPage"
             Title="Presenças"
             BackgroundColor="#F4F6FB">

    <Grid RowDefinitions="Auto,*" Padding="20,16,20,0" RowSpacing="12">

        <VerticalStackLayout Grid.Row="0" Spacing="10">

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0"
                        Text="Próximos"
                        FontFamily="OpenSansSemibold"
                        FontSize="15"
                        CornerRadius="14"
                        HeightRequest="44"
                        BackgroundColor="{Binding CorFundoAbaProximos}"
                        TextColor="{Binding CorTextoAbaProximos}"
                        Command="{Binding MostrarProximosCommand}" />

                <Button Grid.Column="1"
                        Text="Encerrados"
                        FontFamily="OpenSansSemibold"
                        FontSize="15"
                        CornerRadius="14"
                        HeightRequest="44"
                        BackgroundColor="{Binding CorFundoAbaEncerrados}"
                        TextColor="{Binding CorTextoAbaEncerrados}"
                        Command="{Binding MostrarEncerradosCommand}" />
            </Grid>

            <Label Text="{Binding Resumo}"
                   FontSize="15"
                   TextColor="#6B7390" />

        </VerticalStackLayout>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Itens}"
                        SelectionMode="Single"
                        SelectionChanged="OnEventoSelecionado">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
            </CollectionView.ItemsLayout>

            <CollectionView.EmptyView>
                <VerticalStackLayout Spacing="8" Margin="0,50,0,0">
                    <Label Text="✋"
                           FontSize="44"
                           HorizontalOptions="Center" />
                    <Label Text="Nenhum evento nesta lista."
                           FontFamily="OpenSansSemibold"
                           FontSize="17"
                           TextColor="#1B2559"
                           HorizontalOptions="Center" />
                    <Label Text="Publique uma novidade com data e confirmação de presença para ela aparecer aqui."
                           FontSize="13"
                           LineHeight="1.3"
                           TextColor="#6B7390"
                           HorizontalTextAlignment="Center"
                           Margin="20,0" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeShape="RoundRectangle 20"
                            Stroke="#E4E8F4"
                            StrokeThickness="1"
                            BackgroundColor="White"
                            Padding="18">

                        <VerticalStackLayout Spacing="8">

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Label Grid.Column="0"
                                       Text="{Binding Titulo}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="18"
                                       TextColor="#1B2559" />

                                <Border Grid.Column="1"
                                        StrokeShape="RoundRectangle 12"
                                        StrokeThickness="0"
                                        BackgroundColor="#EEF2FF"
                                        Padding="10,5"
                                        VerticalOptions="Start">
                                    <Label Text="{Binding Situacao}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="12"
                                           TextColor="#3C4A7D" />
                                </Border>
                            </Grid>

                            <Label Text="{Binding TextoData}"
                                   FontSize="13"
                                   TextColor="#B07A12" />

                            <Label Text="{Binding TextoPessoas}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="22"
                                   TextColor="#1F6B47" />

                            <Label Text="{Binding TextoDetalhe}"
                                   FontSize="13"
                                   LineHeight="1.3"
                                   TextColor="#6B7390" />

                            <Label Text="Toque para ver os nomes ›"
                                   IsVisible="{Binding TemConfirmacoes}"
                                   FontSize="12"
                                   TextColor="#1B2F7A" />

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <BoxView HeightRequest="24" Color="Transparent" />
            </CollectionView.Footer>

        </CollectionView>
    </Grid>

</ContentPage>