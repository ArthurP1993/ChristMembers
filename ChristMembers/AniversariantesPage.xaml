<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ChristMembers.ViewModels"
             x:Class="ChristMembers.AniversariantesPage"
             Title="Aniversariantes"
             BackgroundColor="#F4F6FB">

    <Grid RowDefinitions="Auto,*" Padding="20,16,20,0" RowSpacing="12">

        <VerticalStackLayout Grid.Row="0" Spacing="10">

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0"
                        Text="Próximos 7 dias"
                        FontFamily="OpenSansSemibold"
                        FontSize="15"
                        CornerRadius="14"
                        HeightRequest="44"
                        BackgroundColor="{Binding CorFundoAbaSemana}"
                        TextColor="{Binding CorTextoAbaSemana}"
                        Command="{Binding MostrarSemanaCommand}" />

                <Button Grid.Column="1"
                        Text="Este mês"
                        FontFamily="OpenSansSemibold"
                        FontSize="15"
                        CornerRadius="14"
                        HeightRequest="44"
                        BackgroundColor="{Binding CorFundoAbaMes}"
                        TextColor="{Binding CorTextoAbaMes}"
                        Command="{Binding MostrarMesCommand}" />
            </Grid>

            <Label Text="{Binding Resumo}"
                   FontSize="15"
                   TextColor="#6B7390" />

            <Label Text="{Binding AvisoSemData}"
                   IsVisible="{Binding TemAvisoSemData}"
                   FontSize="13"
                   TextColor="#B07A12" />

        </VerticalStackLayout>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Itens}">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
            </CollectionView.ItemsLayout>

            <CollectionView.EmptyView>
                <VerticalStackLayout Spacing="8" Margin="0,50,0,0">
                    <Label Text="🎂"
                           FontSize="44"
                           HorizontalOptions="Center" />
                    <Label Text="Nenhum aniversário neste período."
                           FontFamily="OpenSansSemibold"
                           FontSize="17"
                           TextColor="#1B2559"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeShape="RoundRectangle 20"
                            Stroke="#E4E8F4"
                            StrokeThickness="1"
                            BackgroundColor="White"
                            Padding="18">

                        <Border.Triggers>
                            <DataTrigger TargetType="Border"
                                         Binding="{Binding EhHoje}"
                                         Value="True">
                                <Setter Property="BackgroundColor" Value="#FFF6DC" />
                                <Setter Property="Stroke" Value="#F2C14E" />
                            </DataTrigger>
                        </Border.Triggers>

                        <VerticalStackLayout Spacing="8">

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Grid.Column="0" Spacing="3">
                                    <Label Text="{Binding Nome}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="18"
                                           TextColor="#1B2559" />
                                    <Label FontSize="13" TextColor="#6B7390">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding TextoIdade}" />
                                                <Span Text="  ·  " />
                                                <Span Text="{Binding TextoData}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>

                                <Border Grid.Column="1"
                                        StrokeShape="RoundRectangle 12"
                                        StrokeThickness="0"
                                        BackgroundColor="#EEF2FF"
                                        Padding="10,5"
                                        VerticalOptions="Start">
                                    <Label Text="{Binding TextoQuando}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="12"
                                           TextColor="#3C4A7D" />
                                </Border>
                            </Grid>

                            <Button Text="Parabenizar no WhatsApp"
                                    IsVisible="{Binding PodeWhatsApp}"
                                    FontSize="13"
                                    TextColor="#1F6B47"
                                    BackgroundColor="#E3F6EC"
                                    CornerRadius="12"
                                    HeightRequest="40"
                                    HorizontalOptions="Start"
                                    Padding="16,0"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AniversariantesViewModel}}, Path=ParabenizarCommand}"
                                    CommandParameter="{Binding .}" />

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <BoxView HeightRequest="24" Color="Transparent" />
            </CollectionView.Footer>

        </CollectionView>
    </Grid>

</ContentPage>