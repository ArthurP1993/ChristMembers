<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:ChristMembers.Behaviors"
             x:Class="ChristMembers.NovidadeDetalhePage"
             Title="Novidade"
             BackgroundColor="#F4F6FB">

    <ScrollView>
        <VerticalStackLayout Padding="20,20,20,48" Spacing="18">

            <!-- A novidade -->
            <Border StrokeShape="RoundRectangle 24"
                    Stroke="#E4E8F4"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    Padding="0">

                <VerticalStackLayout Spacing="0">

                    <Image Source="{Binding Novidade.CaminhoFoto}"
                           IsVisible="{Binding Novidade.TemFoto}"
                           Aspect="AspectFit"
                           MaximumHeightRequest="480"
                           BackgroundColor="#EEF0F7" />

                    <VerticalStackLayout Padding="20" Spacing="10">

                        <Border IsVisible="{Binding Novidade.TemDataEvento}"
                                StrokeShape="RoundRectangle 14"
                                StrokeThickness="0"
                                BackgroundColor="#FFF0CC"
                                Padding="12,5"
                                HorizontalOptions="Start">
                            <Label Text="{Binding Novidade.TextoEvento, StringFormat='📅 {0}'}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="13"
                                   TextColor="#8A5A00" />
                        </Border>

                        <Label Text="{Binding Novidade.Titulo}"
                               FontFamily="OpenSansSemibold"
                               FontSize="24"
                               TextColor="#1B2559"
                               SemanticProperties.HeadingLevel="Level1" />

                        <Label Text="{Binding Novidade.Descricao}"
                               FontSize="16"
                               LineHeight="1.45"
                               TextColor="#4A5275" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Presença -->
            <Border IsVisible="{Binding PodeConfirmar}"
                    StrokeShape="RoundRectangle 24"
                    Stroke="#E4E8F4"
                    StrokeThickness="1"
                    BackgroundColor="White"
                    Padding="20">

                <VerticalStackLayout Spacing="14">

                    <Label Text="Confirme sua presença"
                           FontFamily="OpenSansSemibold"
                           FontSize="20"
                           TextColor="#1B2559" />

                    <!-- Abas -->
                    <Grid IsVisible="{Binding MostrarAbas}"
                          ColumnDefinitions="*,*"
                          ColumnSpacing="10">
                        <Button Grid.Column="0"
                                Text="Sou membro"
                                FontFamily="OpenSansSemibold"
                                FontSize="15"
                                CornerRadius="14"
                                HeightRequest="44"
                                BackgroundColor="{Binding CorFundoAbaMembro}"
                                TextColor="{Binding CorTextoAbaMembro}"
                                Command="{Binding AbaMembroCommand}" />

                        <Button Grid.Column="1"
                                Text="Não sou membro"
                                FontFamily="OpenSansSemibold"
                                FontSize="15"
                                CornerRadius="14"
                                HeightRequest="44"
                                BackgroundColor="{Binding CorFundoAbaVisitante}"
                                TextColor="{Binding CorTextoAbaVisitante}"
                                Command="{Binding AbaVisitanteCommand}" />
                    </Grid>

                    <!-- Login do membro -->
                    <VerticalStackLayout IsVisible="{Binding MostrarLogin}" Spacing="12">

                        <Entry Placeholder="E-mail"
                               Keyboard="Email"
                               TextColor="#1B2559"
                               PlaceholderColor="#9AA1BC"
                               IsSpellCheckEnabled="False"
                               Text="{Binding EmailLogin}" />

                        <Entry Placeholder="Senha"
                               IsPassword="True"
                               TextColor="#1B2559"
                               PlaceholderColor="#9AA1BC"
                               Text="{Binding SenhaLogin}" />

                        <Button Text="Entrar"
                                FontFamily="OpenSansSemibold"
                                FontSize="16"
                                TextColor="White"
                                BackgroundColor="#1B2F7A"
                                CornerRadius="14"
                                HeightRequest="48"
                                Command="{Binding EntrarCommand}" />

                        <Label Text="Use o mesmo e-mail e senha do seu acesso. Você será desconectado ao sair desta tela."
                               FontSize="12"
                               LineHeight="1.3"
                               TextColor="#6B7390" />
                    </VerticalStackLayout>

                    <!-- Membro logado -->
                    <VerticalStackLayout IsVisible="{Binding MostrarPainelMembro}" Spacing="14">

                        <Label Text="{Binding NomeMembro, StringFormat='Confirmar como {0}'}"
                               FontFamily="OpenSansSemibold"
                               FontSize="17"
                               TextColor="#1B2559" />

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Quantas pessoas vão (contando com você)?"
                                   FontSize="13"
                                   TextColor="#6B7390" />
                            <HorizontalStackLayout Spacing="14">
                                <Button Text="−"
                                        FontSize="22"
                                        WidthRequest="48"
                                        HeightRequest="48"
                                        CornerRadius="24"
                                        Padding="0"
                                        TextColor="#1B2F7A"
                                        BackgroundColor="#E4EBFF"
                                        Command="{Binding MenosCommand}" />
                                <Label Text="{Binding TextoPessoas}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="20"
                                       TextColor="#1B2559"
                                       WidthRequest="110"
                                       HorizontalTextAlignment="Center"
                                       VerticalOptions="Center" />
                                <Button Text="+"
                                        FontSize="22"
                                        WidthRequest="48"
                                        HeightRequest="48"
                                        CornerRadius="24"
                                        Padding="0"
                                        TextColor="#1B2F7A"
                                        BackgroundColor="#E4EBFF"
                                        Command="{Binding MaisCommand}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <Button Text="Confirmar presença"
                                FontFamily="OpenSansSemibold"
                                FontSize="17"
                                TextColor="White"
                                BackgroundColor="#1B2F7A"
                                CornerRadius="16"
                                HeightRequest="52"
                                Command="{Binding ConfirmarMembroCommand}" />
                    </VerticalStackLayout>

                    <!-- Formulário básico -->
                    <VerticalStackLayout IsVisible="{Binding MostrarFormulario}" Spacing="12">

                        <Entry Placeholder="Seu nome"
                               TextColor="#1B2559"
                               PlaceholderColor="#9AA1BC"
                               Text="{Binding Nome}" />

                        <Entry Placeholder="Telefone (11) 99999-9999"
                               Keyboard="Numeric"
                               TextColor="#1B2559"
                               PlaceholderColor="#9AA1BC"
                               Text="{Binding Telefone}">
                            <Entry.Behaviors>
                                <behaviors:MascaraTelefoneBehavior />
                            </Entry.Behaviors>
                        </Entry>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Quantas pessoas vão (contando com você)?"
                                   FontSize="13"
                                   TextColor="#6B7390" />
                            <HorizontalStackLayout Spacing="14">
                                <Button Text="−"
                                        FontSize="22"
                                        WidthRequest="48"
                                        HeightRequest="48"
                                        CornerRadius="24"
                                        Padding="0"
                                        TextColor="#1B2F7A"
                                        BackgroundColor="#E4EBFF"
                                        Command="{Binding MenosCommand}" />
                                <Label Text="{Binding TextoPessoas}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="20"
                                       TextColor="#1B2559"
                                       WidthRequest="110"
                                       HorizontalTextAlignment="Center"
                                       VerticalOptions="Center" />
                                <Button Text="+"
                                        FontSize="22"
                                        WidthRequest="48"
                                        HeightRequest="48"
                                        CornerRadius="24"
                                        Padding="0"
                                        TextColor="#1B2F7A"
                                        BackgroundColor="#E4EBFF"
                                        Command="{Binding MaisCommand}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <Button Text="Confirmar presença"
                                FontFamily="OpenSansSemibold"
                                FontSize="17"
                                TextColor="White"
                                BackgroundColor="#1B2F7A"
                                CornerRadius="16"
                                HeightRequest="52"
                                Command="{Binding ConfirmarFormularioCommand}" />

                        <Label Text="Usaremos o seu nome e telefone só para organizar este evento."
                               FontSize="12"
                               LineHeight="1.3"
                               TextColor="#6B7390" />
                    </VerticalStackLayout>

                    <!-- Confirmado (logado) -->
                    <VerticalStackLayout IsVisible="{Binding MostrarConfirmadoLogado}" Spacing="12">
                        <Label Text="✓ Presença confirmada"
                               FontFamily="OpenSansSemibold"
                               FontSize="20"
                               TextColor="#2E7D5B" />
                        <Label Text="{Binding TextoConfirmadoLogado}"
                               FontSize="15"
                               TextColor="#4A5275" />
                        <Button Text="Cancelar presença"
                                FontSize="14"
                                TextColor="#C62828"
                                BackgroundColor="#FDECEC"
                                CornerRadius="14"
                                HeightRequest="44"
                                HorizontalOptions="Start"
                                Padding="18,0"
                                Command="{Binding CancelarCommand}" />
                    </VerticalStackLayout>

                    <!-- Confirmado (sem login) -->
                    <VerticalStackLayout IsVisible="{Binding MostrarConfirmadoVisitante}" Spacing="12">
                        <Label Text="✓ Presença confirmada"
                               FontFamily="OpenSansSemibold"
                               FontSize="20"
                               TextColor="#2E7D5B" />
                        <Label Text="{Binding TextoConfirmadoVisitante}"
                               FontSize="15"
                               LineHeight="1.35"
                               TextColor="#4A5275" />
                        <Label Text="Para cancelar, fale com a liderança da igreja."
                               FontSize="12"
                               TextColor="#6B7390" />
                        <Button Text="Confirmar outra pessoa"
                                FontSize="14"
                                TextColor="#1B2F7A"
                                BackgroundColor="#E4EBFF"
                                CornerRadius="14"
                                HeightRequest="44"
                                HorizontalOptions="Start"
                                Padding="18,0"
                                Command="{Binding OutraPessoaCommand}" />
                    </VerticalStackLayout>

                    <Label Text="{Binding MensagemErro}"
                           IsVisible="{Binding TemErro}"
                           TextColor="#C62828"
                           FontSize="14" />

                </VerticalStackLayout>
            </Border>

            <!-- Administrador -->
            <Button Text="Ver quem confirmou"
                    IsVisible="{Binding MostrarAdmin}"
                    FontFamily="OpenSansSemibold"
                    FontSize="16"
                    TextColor="#1B2F7A"
                    BackgroundColor="#E4EBFF"
                    CornerRadius="16"
                    HeightRequest="50"
                    Command="{Binding VerConfirmadosCommand}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>