<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:ChristMembers.Behaviors"
             x:Class="ChristMembers.EditarMembroPage"
             Title="Editar cadastro">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,20,30,60"
            Spacing="25">

            <Image
                Source="logo.png"
                HeightRequest="120"
                HorizontalOptions="Center"/>

            <Label
                Text="Editar cadastro"
                FontSize="20"
                HorizontalOptions="Center" />

            <!-- Dados pessoais -->
            <Entry Placeholder="Nome" Text="{Binding Nome}" />

            <Entry Placeholder="Telefone (11) 99999-9999"
                   Keyboard="Numeric"
                   Text="{Binding Telefone}">
                <Entry.Behaviors>
                    <behaviors:MascaraTelefoneBehavior />
                </Entry.Behaviors>
            </Entry>

            <Entry Placeholder="CPF (000.000.000-00)"
                   Keyboard="Numeric"
                   Text="{Binding CPF}">
                <Entry.Behaviors>
                    <behaviors:MascaraCpfBehavior />
                </Entry.Behaviors>
            </Entry>

            <Entry Placeholder="Data de nascimento (dd/mm/aaaa)"
                   Keyboard="Numeric"
                   Text="{Binding DataNascimentoTexto}">
                <Entry.Behaviors>
                    <behaviors:MascaraDataBehavior />
                </Entry.Behaviors>
            </Entry>

            <Picker Title="Gênero"
                    ItemsSource="{Binding Generos}"
                    ItemDisplayBinding="{Binding Nome}"
                    SelectedItem="{Binding GeneroSelecionado}" />

            <Picker Title="Estado civil"
                    ItemsSource="{Binding EstadosCivis}"
                    ItemDisplayBinding="{Binding Nome}"
                    SelectedItem="{Binding EstadoCivilSelecionado}" />

            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                <Label Text="Tem filhos?"
                       FontAttributes="Bold"
                       Margin="0,6,0,0" />
                <RadioButton Content="Sim"
                             GroupName="FilhosEdicao"
                             IsChecked="{Binding FilhosSim}"
                             VerticalOptions="Center" />
                <RadioButton Content="Não"
                             GroupName="FilhosEdicao"
                             IsChecked="{Binding FilhosNao}"
                             VerticalOptions="Center" />
                <RadioButton Content="Não informado"
                             GroupName="FilhosEdicao"
                             IsChecked="{Binding FilhosNaoInformado}"
                             VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Entry Placeholder="Email" Keyboard="Email" Text="{Binding Email}" />

            <!-- Endereço -->
            <Entry Placeholder="Cep" Keyboard="Numeric" Text="{Binding CEP}" />
            <Entry Placeholder="Endereço" Text="{Binding Endereco}" />
            <Entry Placeholder="Numero" Text="{Binding Numero}" />
            <Entry Placeholder="Complemento" Text="{Binding Complemento}" />
            <Entry Placeholder="Bairro" Text="{Binding Bairro}" />
            <Entry Placeholder="Cidade" Text="{Binding Cidade}" />
            <Entry Placeholder="Estado" Text="{Binding Estado}" />

            <!-- Na igreja -->
            <Entry Placeholder="Data de filiação (dd/mm/aaaa)"
                   Keyboard="Numeric"
                   Text="{Binding DataEntradaTexto}">
                <Entry.Behaviors>
                    <behaviors:MascaraDataBehavior />
                </Entry.Behaviors>
            </Entry>

            <Picker Title="Consagração"
                    ItemsSource="{Binding Consagracoes}"
                    ItemDisplayBinding="{Binding Nome}"
                    SelectedItem="{Binding ConsagracaoSelecionada}" />

            <Picker Title="Setor"
                    ItemsSource="{Binding Setores}"
                    ItemDisplayBinding="{Binding Nome}"
                    SelectedItem="{Binding SetorSelecionado}" />

            <Entry Placeholder="Sigla da congregação (ex.: SEDE)"
                   MaxLength="10"
                   TextTransform="Uppercase"
                   Text="{Binding SiglaCongregacao}" />

            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                <Label Text="Foi batizado?"
                       FontAttributes="Bold"
                       Margin="0,6,0,0" />
                <RadioButton Content="Sim"
                             GroupName="BatismoEdicao"
                             IsChecked="{Binding BatizadoSim}"
                             VerticalOptions="Center" />
                <RadioButton Content="Não"
                             GroupName="BatismoEdicao"
                             IsChecked="{Binding BatizadoNao}"
                             VerticalOptions="Center" />
                <RadioButton Content="Não informado"
                             GroupName="BatismoEdicao"
                             IsChecked="{Binding BatizadoNaoInformado}"
                             VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Entry Placeholder="Data do batismo (dd/mm/aaaa)"
                   IsVisible="{Binding MostrarDataBatismo}"
                   Keyboard="Numeric"
                   Text="{Binding DataBatismoTexto}">
                <Entry.Behaviors>
                    <behaviors:MascaraDataBehavior />
                </Entry.Behaviors>
            </Entry>

            <!-- Deficiência: só o que o próprio membro informou pode ser corrigido -->
            <VerticalStackLayout IsVisible="{Binding PodeEditarDeficiencia}" Spacing="25">

                <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                    <Label Text="Possui deficiência?"
                           FontAttributes="Bold"
                           Margin="0,6,0,0" />
                    <RadioButton Content="Sim"
                                 GroupName="DeficienciaEdicao"
                                 IsChecked="{Binding DeficienciaSim}"
                                 VerticalOptions="Center" />
                    <RadioButton Content="Não (remover)"
                                 GroupName="DeficienciaEdicao"
                                 IsChecked="{Binding DeficienciaNao}"
                                 VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Picker Title="Tipo de deficiência"
                        IsVisible="{Binding MostrarTipoDeficiencia}"
                        ItemsSource="{Binding Deficiencias}"
                        ItemDisplayBinding="{Binding Nome}"
                        SelectedItem="{Binding DeficienciaSelecionada}" />

                <VerticalStackLayout IsVisible="{Binding MostrarOutros}" Spacing="4">
                    <Editor Placeholder="Descreva a deficiência (máximo 500 caracteres)"
                            MaxLength="500"
                            HeightRequest="120"
                            Text="{Binding DeficienciaOutros}" />
                    <Label Text="{Binding ContadorOutros}"
                           FontSize="12"
                           TextColor="Gray"
                           HorizontalOptions="End" />
                </VerticalStackLayout>

            </VerticalStackLayout>

            <Label Text="{Binding TextoDeficienciaSomenteLeitura}"
                   IsVisible="{Binding MostrarDeficienciaSomenteLeitura}"
                   FontSize="14"
                   LineHeight="1.35"
                   TextColor="Gray" />

            <!-- Observações -->
            <Editor Placeholder="Observações"
                    HeightRequest="120"
                    Text="{Binding Observacao}" />

            <Label Text="{Binding MensagemErro}"
                   TextColor="Red"
                   IsVisible="{Binding TemErro}" />

            <Button Text="Salvar alterações"
                    Command="{Binding SalvarCommand}" />

            <Button Text="Cancelar"
                    BackgroundColor="Transparent"
                    TextColor="Gray"
                    Command="{Binding CancelarCommand}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>