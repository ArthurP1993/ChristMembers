<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ChristMembers.HomePage">

<Grid Padding="24">
        <Button
            Text="Cadastrar-se"
            WidthRequest="130"
            HorizontalOptions="End"
            VerticalOptions="Start"
            Clicked="SignUpClicked" />

        <VerticalStackLayout
            Spacing="20"
            HorizontalOptions="Center"
            VerticalOptions="Center">

            <Image
                Source="dotnet_bot.png"
                HeightRequest="150"
                HorizontalOptions="Center" />

            <Label
                Text="IADA"
                FontSize="40"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="Seja bem-vindo!"
                FontSize="20"
                HorizontalOptions="Center" />

            <Button
                Text="Membros"
                WidthRequest="240"
                HeightRequest="60"
                Clicked="OnMembrosClicked" />

            <Button
                Text="Visitantes"
                WidthRequest="240"
                HeightRequest="60"
                Clicked="OnVisitantesClicked" />

        </VerticalStackLayout>
    </Grid>
</ContentPage>