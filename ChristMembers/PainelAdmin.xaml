<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ChristMembers.PainelAdmin"
             Title="Painel"
             BackgroundColor="#F4F6FB">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" />
    </Shell.BackButtonBehavior>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Sair" Clicked="OnSairClicked" />
    </ContentPage.ToolbarItems>
    
    <ScrollView>
        <VerticalStackLayout Padding="24,32,24,60" Spacing="20">

            <VerticalStackLayout Spacing="8" Margin="0,0,0,8">
                <Label Text="Painel do administrador"
                       FontFamily="OpenSansSemibold"
                       FontSize="30"
                       TextColor="#1B2559"
                       SemanticProperties.HeadingLevel="Level1" />
                <Label Text="Escolha o que deseja gerenciar."
                       FontSize="16"
                       TextColor="#6B7390" />
            </VerticalStackLayout>

            <!-- Membros -->
            <Grid>
                <Border StrokeShape="RoundRectangle 24"
                        Stroke="#E4E8F4"
                        StrokeThickness="1"
                        BackgroundColor="White"
                        Padding="20">
                    <Border.Shadow>
                        <Shadow Brush="#1B2F7A" Opacity="0.10" Radius="20" Offset="0,8" />
                    </Border.Shadow>

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                        <Border Grid.Column="0"
                                StrokeShape="Ellipse"
                                StrokeThickness="0"
                                BackgroundColor="#E4EBFF"
                                WidthRequest="60"
                                HeightRequest="60">
                            <Label Text="👥"
                                   FontSize="28"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label Text="Membros"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="20"
                                   TextColor="#1B2559" />
                            <Label Text="Ver os membros cadastrados"
                                   FontSize="14"
                                   TextColor="#6B7390" />
                        </VerticalStackLayout>

                        <Label Grid.Column="2"
                               Text="›"
                               FontSize="34"
                               TextColor="#9AA1BC"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Button BackgroundColor="Transparent"
                        CornerRadius="24"
                        SemanticProperties.Description="Membros"
                        Clicked="OnMembrosClicked" />
            </Grid>

            <!-- Visitantes -->
            <Grid>
                <Border StrokeShape="RoundRectangle 24"
                        Stroke="#E4E8F4"
                        StrokeThickness="1"
                        BackgroundColor="White"
                        Padding="20">
                    <Border.Shadow>
                        <Shadow Brush="#1B2F7A" Opacity="0.10" Radius="20" Offset="0,8" />
                    </Border.Shadow>

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                        <Border Grid.Column="0"
                                StrokeShape="Ellipse"
                                StrokeThickness="0"
                                BackgroundColor="#FFF0CC"
                                WidthRequest="60"
                                HeightRequest="60">
                            <Label Text="🙋"
                                   FontSize="28"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label Text="Visitantes"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="20"
                                   TextColor="#1B2559" />
                            <Label Text="Ver os visitantes cadastrados"
                                   FontSize="14"
                                   TextColor="#6B7390" />
                        </VerticalStackLayout>

                        <Label Grid.Column="2"
                               Text="›"
                               FontSize="34"
                               TextColor="#9AA1BC"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Button BackgroundColor="Transparent"
                        CornerRadius="24"
                        SemanticProperties.Description="Visitantes"
                        Clicked="OnVisitantesClicked" />
            </Grid>

            <!-- Novidades -->
            <Grid>
                <Border StrokeShape="RoundRectangle 24"
            Stroke="#E4E8F4"
            StrokeThickness="1"
            BackgroundColor="White"
            Padding="20">
                    <Border.Shadow>
                        <Shadow Brush="#1B2F7A" Opacity="0.10" Radius="20" Offset="0,8" />
                    </Border.Shadow>

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                        <Border Grid.Column="0"
                    StrokeShape="Ellipse"
                    StrokeThickness="0"
                    BackgroundColor="#EEE6FF"
                    WidthRequest="60"
                    HeightRequest="60">
                            <Label Text="📣"
                       FontSize="28"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label Text="Novidades"
                       FontFamily="OpenSansSemibold"
                       FontSize="20"
                       TextColor="#1B2559" />
                            <Label Text="Publicar e acompanhar avisos"
                       FontSize="14"
                       TextColor="#6B7390" />
                        </VerticalStackLayout>

                        <Label Grid.Column="2"
                   Text="›"
                   FontSize="34"
                   TextColor="#9AA1BC"
                   VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Button BackgroundColor="Transparent"
            CornerRadius="24"
            SemanticProperties.Description="Novidades"
            Clicked="OnNovidadesClicked" />
            </Grid>

            <!-- Pedidos de oração -->
            <Grid>
                <Border StrokeShape="RoundRectangle 24"
                        Stroke="#E4E8F4"
                        StrokeThickness="1"
                        BackgroundColor="White"
                        Padding="20">
                                <Border.Shadow>
                                    <Shadow Brush="#1B2F7A" Opacity="0.10" Radius="20" Offset="0,8" />
                                </Border.Shadow>

                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                    <Border Grid.Column="0"
                                StrokeShape="Ellipse"
                                StrokeThickness="0"
                                BackgroundColor="#E3F6EC"
                                WidthRequest="60"
                                HeightRequest="60">
                                        <Label Text="🙏"
                                   FontSize="28"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                        <Label Text="Pedidos de oração"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="20"
                                   TextColor="#1B2559" />
                                        <Label Text="Acompanhar e responder pedidos"
                                   FontSize="14"
                                   TextColor="#6B7390" />
                                    </VerticalStackLayout>

                                    <HorizontalStackLayout Grid.Column="2"
                                               Spacing="10"
                                               VerticalOptions="Center">

                                        <Border x:Name="BadgePedidos"
                                    IsVisible="False"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="0"
                                    BackgroundColor="#C62828"
                                    Padding="9,3"
                                    VerticalOptions="Center">
                                            <Label x:Name="TextoBadgePedidos"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="12"
                                       TextColor="White" />
                                        </Border>

                                        <Label Text="›"
                                   FontSize="34"
                                   TextColor="#9AA1BC"
                                   VerticalOptions="Center" />

                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>

                            <Button BackgroundColor="Transparent"
                        CornerRadius="24"
                        SemanticProperties.Description="Pedidos de oração"
                        Clicked="OnPedidosOracaoClicked" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>