<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ChristMembers.ViewModels"
             x:Class="ChristMembers.MuralOracaoPage"
             Title="Mural de oração"
             BackgroundColor="#F4F6FB">

    <CollectionView ItemsSource="{Binding Pedidos}"
                    Margin="20,0,20,0">

        <CollectionView.ItemsLayout>
            <LinearItemsLayout Orientation="Vertical" ItemSpacing="16" />
        </CollectionView.ItemsLayout>

        <CollectionView.Header>
            <VerticalStackLayout Spacing="6" Padding="0,20,0,20">
                <Label Text="Orando uns pelos outros"
                       FontFamily="OpenSansSemibold"
                       FontSize="28"
                       TextColor="#1B2559"
                       SemanticProperties.HeadingLevel="Level1" />
                <Label Text="Pedidos compartilhados com a igreja. Toque para dizer que está orando."
                       FontSize="15"
                       LineHeight="1.4"
                       TextColor="#6B7390" />
            </VerticalStackLayout>
        </CollectionView.Header>

        <CollectionView.EmptyView>
            <VerticalStackLayout Spacing="8" Margin="0,50,0,0">
                <Label Text="🙏"
                       FontSize="48"
                       HorizontalOptions="Center" />
                <Label Text="O mural está vazio por enquanto."
                       FontFamily="OpenSansSemibold"
                       FontSize="18"
                       TextColor="#1B2559"
                       HorizontalOptions="Center" />
                <Label Text="Os pedidos autorizados aparecem aqui."
                       FontSize="14"
                       TextColor="#6B7390"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </CollectionView.EmptyView>

        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Border StrokeShape="RoundRectangle 24"
                        Stroke="#E4E8F4"
                        StrokeThickness="1"
                        BackgroundColor="White"
                        Padding="20">
                    <Border.Shadow>
                        <Shadow Brush="#1B2F7A" Opacity="0.08" Radius="18" Offset="0,6" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="14">

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Border Grid.Column="0"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="0"
                                    BackgroundColor="#E3F6EC"
                                    Padding="10,4">
                                <Label Text="{Binding Categoria}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="12"
                                       TextColor="#1F6B47" />
                            </Border>

                            <Label Grid.Column="1"
                                   Text="{Binding DataTexto}"
                                   FontSize="12"
                                   TextColor="#9AA1BC"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center" />
                        </Grid>

                        <Label Text="{Binding Texto}"
                               FontSize="16"
                               LineHeight="1.45"
                               TextColor="#2E3760" />

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Label Grid.Column="0"
                                   Text="{Binding TextoOracoes}"
                                   FontSize="13"
                                   TextColor="#6B7390"
                                   VerticalOptions="Center" />

                            <Button Grid.Column="1"
                                    Text="{Binding TextoBotaoOrar}"
                                    IsEnabled="{Binding PodeOrar}"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="14"
                                    TextColor="White"
                                    BackgroundColor="#1B2F7A"
                                    CornerRadius="14"
                                    HeightRequest="42"
                                    Padding="18,0"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MuralOracaoViewModel}}, Path=OrarCommand}"
                                    CommandParameter="{Binding .}" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>

        <CollectionView.Footer>
            <BoxView HeightRequest="30" Color="Transparent" />
        </CollectionView.Footer>

    </CollectionView>

</ContentPage>