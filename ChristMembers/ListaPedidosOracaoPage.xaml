<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ChristMembers.ViewModels"
             x:Class="ChristMembers.ListaPedidosOracaoPage"
             Title="Pedidos de oração"
             BackgroundColor="#F4F6FB">

    <Grid RowDefinitions="Auto,*" Padding="20,16,20,0" RowSpacing="12">

        <!-- Filtros -->
        <VerticalStackLayout Grid.Row="0" Spacing="8">

            <Label Text="{Binding Resumo}"
                   FontSize="14"
                   TextColor="#6B7390" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Picker Grid.Column="0"
                        Title="Status"
                        ItemsSource="{Binding OpcoesStatus}"
                        SelectedItem="{Binding StatusFiltro}"
                        TextColor="#1B2559"
                        TitleColor="#9AA1BC" />

                <Picker Grid.Column="1"
                        Title="Categoria"
                        ItemsSource="{Binding OpcoesCategoria}"
                        SelectedItem="{Binding CategoriaFiltro}"
                        TextColor="#1B2559"
                        TitleColor="#9AA1BC" />
            </Grid>

        </VerticalStackLayout>

        <!-- Lista -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding Pedidos}">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="14" />
            </CollectionView.ItemsLayout>

            <CollectionView.EmptyView>
                <VerticalStackLayout Spacing="8" Margin="0,50,0,0">
                    <Label Text="🙏"
                           FontSize="44"
                           HorizontalOptions="Center" />
                    <Label Text="Nenhum pedido por aqui."
                           FontFamily="OpenSansSemibold"
                           FontSize="17"
                           TextColor="#1B2559"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeShape="RoundRectangle 22"
                            Stroke="#E4E8F4"
                            StrokeThickness="1"
                            BackgroundColor="White"
                            Padding="18">

                        <VerticalStackLayout Spacing="12">

                            <!-- Quem e status -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding NomeExibicao}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="18"
                                           TextColor="#1B2559" />
                                    <Label FontSize="12" TextColor="#9AA1BC">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Categoria}" />
                                                <Span Text="  ·  " />
                                                <Span Text="{Binding DataTexto}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>

                                <Border Grid.Column="1"
                                        StrokeShape="RoundRectangle 12"
                                        StrokeThickness="0"
                                        BackgroundColor="#EEF2FF"
                                        Padding="10,5"
                                        VerticalOptions="Start">
                                    <Label Text="{Binding TextoStatus}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="12"
                                           TextColor="#3C4A7D" />
                                </Border>
                            </Grid>

                            <!-- Pedido -->
                            <Label Text="{Binding Texto}"
                                   FontSize="15"
                                   LineHeight="1.4"
                                   TextColor="#2E3760" />

                            <!-- Mural -->
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8"
                                  IsVisible="{Binding PermiteMural}">
                                <Label Grid.Column="0"
                                       Text="{Binding TextoSituacaoMural}"
                                       FontSize="12"
                                       LineHeight="1.3"
                                       TextColor="#2E7D5B"
                                       VerticalOptions="Center" />

                                <Button Grid.Column="1"
                                        Text="{Binding TextoAcaoMural}"
                                        FontSize="13"
                                        TextColor="#1F6B47"
                                        BackgroundColor="#E3F6EC"
                                        CornerRadius="12"
                                        HeightRequest="38"
                                        Padding="14,0"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ListaPedidosOracaoViewModel}}, Path=AlternarMuralCommand}"
                                        CommandParameter="{Binding .}" />
                            </Grid>

                            <!-- Contato -->
                            <Grid ColumnDefinitions="*,Auto,Auto"
                                  ColumnSpacing="8"
                                  IsVisible="{Binding TemTelefone}">
                                <Label Grid.Column="0"
                                       Text="{Binding Telefone}"
                                       FontSize="14"
                                       TextColor="#6B7390"
                                       VerticalOptions="Center" />

                                <Button Grid.Column="1"
                                        Text="Ligar"
                                        FontSize="13"
                                        TextColor="#1B2F7A"
                                        BackgroundColor="#E4EBFF"
                                        CornerRadius="12"
                                        HeightRequest="38"
                                        Padding="14,0"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ListaPedidosOracaoViewModel}}, Path=LigarCommand}"
                                        CommandParameter="{Binding .}" />

                                <Button Grid.Column="2"
                                        Text="WhatsApp"
                                        FontSize="13"
                                        TextColor="#1F6B47"
                                        BackgroundColor="#E3F6EC"
                                        CornerRadius="12"
                                        HeightRequest="38"
                                        Padding="14,0"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ListaPedidosOracaoViewModel}}, Path=WhatsAppCommand}"
                                        CommandParameter="{Binding .}" />
                            </Grid>

                            <!-- Anotação da liderança -->
                            <Editor Placeholder="Anotação da liderança (ex.: visitei na quinta)"
                                    AutoSize="TextChanges"
                                    MaxLength="300"
                                    FontSize="14"
                                    TextColor="#1B2559"
                                    PlaceholderColor="#9AA1BC"
                                    Text="{Binding Anotacao, Mode=TwoWay}" />

                            <Button Text="Salvar anotação"
                                    FontSize="13"
                                    TextColor="#1B2F7A"
                                    BackgroundColor="Transparent"
                                    BorderColor="#C9D3F5"
                                    BorderWidth="1"
                                    CornerRadius="12"
                                    HeightRequest="38"
                                    HorizontalOptions="Start"
                                    Padding="16,0"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ListaPedidosOracaoViewModel}}, Path=SalvarAnotacaoCommand}"
                                    CommandParameter="{Binding .}" />

                            <!-- Ações -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Button Grid.Column="0"
                                        Text="{Binding TextoProximaAcao}"
                                        FontFamily="OpenSansSemibold"
                                        FontSize="14"
                                        TextColor="White"
                                        BackgroundColor="#1B2F7A"
                                        CornerRadius="14"
                                        HeightRequest="44"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ListaPedidosOracaoViewModel}}, Path=AlterarStatusCommand}"
                                        CommandParameter="{Binding .}" />

                                <Button Grid.Column="1"
                                        Text="Arquivar"
                                        FontSize="14"
                                        TextColor="#8A5A00"
                                        BackgroundColor="#FFF0CC"
                                        CornerRadius="14"
                                        HeightRequest="44"
                                        Padding="16,0"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ListaPedidosOracaoViewModel}}, Path=ArquivarCommand}"
                                        CommandParameter="{Binding .}" />
                            </Grid>

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <BoxView HeightRequest="24" Color="Transparent" />
            </CollectionView.Footer>

        </CollectionView>
    </Grid>

</ContentPage>